#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(dirname "$SCRIPT_DIR")
PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# The dispatcher building blocks (ADR-014) skip the full CLI import: the
# dispatcher runs tens of them per run.
if [ "${1:-}" = "dispatcher" ]; then
    shift
    exec python -m headless_pr_workflow.dispatcher "$@"
fi

python -m headless_pr_workflow.cli "$@"
